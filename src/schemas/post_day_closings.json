{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "PostDayClosings",
  "type": "object",
  "properties": {
    "accounting_date": {
      "type": "string",
      "minLength": 10,
      "maxLength": 10,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  },
  "required": [
    "accounting_date"
  ],
  "additionalProperties": false
}
